# Copy to .env and adjust. Never commit the real .env (see .gitignore).

# Host port published by `docker compose up server`.
HAMSTER_HOST_PORT=8080
# Host port published by the development container.
HAMSTER_DEV_PORT=8081

# Absolute path to a PHP CLI binary. The project targets PHP 8.5 NTS 64-bit.
# Used by scripts/ and the PHP worker tests; both otherwise look for
# php/8.5/php.exe in the repository, then php8.5, then php on PATH.
# Windows development runtime: php/8.5/php.exe
#HAMSTER_PHP=/usr/bin/php8.5

# Listen address used by scripts/dev.sh (defaults to 127.0.0.1:8080).
#HAMSTER_LISTEN=127.0.0.1:8080
